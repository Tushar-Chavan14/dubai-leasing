# Copy to .env and fill in. Never commit .env.

# Database
# Local Postgres install (no Docker). Create with: createuser -P leasing && createdb -O leasing leasing
DATABASE_URL=postgres://tushar:silverFern@localhost:5432/leasing
# Tests DROP and recreate every table here; the name must contain "test".
TEST_DATABASE_URL=postgres://tushar:silverFern@localhost:5432/leasing_test

# Ollama
OLLAMA_URL=http://localhost:11434
# Use the exact tags shown by `ollama list` and pin them.
CHAT_MODEL=gemma4:e4b            # default chat model (slice 4 eval: ties or beats qwen3.5:9b on contract AI and leasing assistant, ~2-5x faster)
VISION_MODEL=
VOICE_MODEL=gemma4:e4b           # voice input transcription (audio capability; local Ollama only)
DECISION_MODEL=tev1:4b
COPILOT_MODEL=qwen3.5:9b       # staff copilot (needs tool calling); empty = CHAT_MODEL. Pinned: gemma4:e4b is 10 points worse on tool choice
CUSTOMER_AGENT_MODEL=qwen3.5:9b # public web chat agent for free text (needs tool calling; local Ollama only); empty = CHAT_MODEL. Pinned: gemma4:e4b misses cards and choice cards
LEASING_ASSISTANT_MODEL=       # enquiry answers; empty = CHAT_MODEL
CONTRACT_AI_MODEL=             # contract-template and contract-structure helpers; empty = CHAT_MODEL
KYC_DOC_TIMEOUT_SECONDS=120    # one KYC document reading is cancelled after this long (retried once, then a person)
KYC_STUCK_MINUTES=10           # a document check running longer shows "didn't finish" with a retry button
BACKGROUND_MODEL_TIMEOUT_SECONDS=300 # Contract AI model calls (background priority) are cancelled after this long
CUSTOMER_AGENT_MAX_CONCURRENT=2 # visitor messages the web chat agent works on at once; others get a "busy, try again" reply

# Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling          # polling | webhook
TELEGRAM_WEBHOOK_URL=          # webhook mode: public HTTPS URL ending in /telegram/webhook
TELEGRAM_WEBHOOK_SECRET=       # webhook mode: Telegram sends it on every call
TELEGRAM_WEBHOOK_PORT=4200     # webhook mode: port the bot listens on behind the HTTPS proxy
# Shared secret between the bot and the engine (≥ 32 chars, same value for both). e.g. `openssl rand -hex 32`
CHANNEL_SECRET=

# Ejari
EJARI_MODE=mock                # mock | live
EJARI_MOCK_URL=http://localhost:4100
MOCK_EJARI_FAILURE_RATE=0      # 0..1, share of requests the simulated registry answers "temporarily unavailable" (shows retries)

# App
ENGINE_PORT=4000
ENGINE_URL=http://localhost:4000   # used by the staff app (server side) and the Telegram bot
# HMAC secret for staff sessions. Required when DEMO_MODE=false. e.g. `openssl rand -hex 32`
SESSION_SECRET=
WEB_URL=http://localhost:3000
TIMEZONE=Asia/Dubai
DEMO_MODE=true
# Move-in through move-out (collections, complaints, renewal, move-out). false hides it: routes, jobs, copilot tools, portal pages.
TENANCY_OPS=false
UPLOADS_DIR=./data/uploads
DOCUMENTS_DIR=./data/documents   # generated PDFs (notices); relative to the repo root
MEDIA_DIR=./data/media           # unit photos (not tenant documents); relative to the repo root; must not overlap UPLOADS_DIR
RULES_VERSION=dubai-2025-01      # fallback only: leases use the published rulebook version in force on their start date (D23)

# Email (Nodemailer). MAIL_TRANSPORT=ethereal creates a throwaway test inbox for dev.
MAIL_TRANSPORT=smtp            # smtp | ethereal
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false              # true for port 465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Leasing Demo <leasing-demo@example.com>"
NOTICE_ACK_FOLLOWUP_DAYS=5
# Demo mode with real SMTP: ALL mail is redirected here (demo tenants are fictional). Required then.
MAIL_DEMO_RECIPIENT=
