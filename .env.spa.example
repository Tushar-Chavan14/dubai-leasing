# SPA (sales) module settings. Copy to .env.spa.local and fill in. Never commit .env.spa.local.
# SPA apps read only this file (docs/spa/decisions.md S25), never .env or .env.local.

# Database (its own database; tests DROP and recreate every table in the test one: name must contain "test")
SPA_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/spa
SPA_TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/spa_test

# Apps
SPA_ENGINE_PORT=4001
SPA_WEB_PORT=3001
SPA_SESSION_COOKIE=spa_session
SPA_DEMO_MODE=true
SPA_SESSION_SECRET=              # needed only when SPA_DEMO_MODE=false: at least 32 random characters (`openssl rand -hex 32`)
SPA_PORTAL_URL=http://localhost:3100   # where "Portal" in the avatar menu goes (module chooser)

# Ollama (local only). Use the exact tags from `ollama list` and pin them. Models are fixed here, not in the UI.
OLLAMA_URL=http://localhost:11434
SPA_CHAT_MODEL=
SPA_VISION_MODEL=
SPA_DECISION_MODEL=
SPA_COPILOT_MODEL=              # staff copilot (needs tool calling); empty = SPA_CHAT_MODEL
SPA_ASSISTANT_MODEL=            # party assistant, listing chat, template assistant (tool calling); empty = SPA_CHAT_MODEL
SPA_VISION_TIMEOUT_SECONDS=120  # one document reading; retried once, then a person
SPA_CHAT_TIMEOUT_SECONDS=60
SPA_ASSISTANT_MAX_CONCURRENT=2

# Simulated services (labelled simulated everywhere)
REGISTRY_MOCK_URL=http://localhost:4101   # Oqood register/transfer + trustee transfer
MOCK_REGISTRY_FAILURE_RATE=0               # 0..1 share of "temporarily unavailable" answers
SCREENING_ADAPTER=fake                     # fake = fictional sanctions/PEP lists

# Mail (all outbound to parties goes by email)
MAIL_TRANSPORT=ethereal         # ethereal | smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SPA_MAIL_FROM=
SPA_MAIL_DEMO_RECIPIENT=        # required with SPA_DEMO_MODE=true and real SMTP

# Files (outside the repo's tracked files; must not overlap)
SPA_DOCUMENTS_DIR=./data/spa/documents
SPA_UPLOADS_DIR=./data/spa/uploads
SPA_MEDIA_DIR=./data/spa/media
