{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "types": ["node", "bun"],
    "allowJs": false,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "app/**/*", "components/**/*", "lib/**/*", "scripts/**/*", "test/**/*", "*.ts"],
  "exclude": ["node_modules", ".next"]
}
