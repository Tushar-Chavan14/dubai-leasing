{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "react", "nextjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": ["**/node_modules/**", "**/.next/**", "packages/db/migrations/**"],
  "rules": {
    "no-console": "off",
    "typescript/no-explicit-any": "warn",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "error",
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "nextjs/no-img-element": "off"
      }
    }
  ]
}
